{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etl4.iisc/schemas/test_result.schema.json",
  "title": "Test Result",
  "type": "object",
  "required": ["project_id", "test_type", "ran_at_utc", "total", "passed", "failed"],
  "properties": {
    "project_id": {"type": "string"},
    "test_type": {"type": "string", "enum": ["unit", "functional", "integration", "e2e", "regression", "ui", "ux", "accessibility", "dashboard"]},
    "ran_at_utc": {"type": "string", "format": "date-time"},
    "ran_by_agent": {"type": "string"},
    "total": {"type": "integer", "minimum": 0},
    "passed": {"type": "integer", "minimum": 0},
    "failed": {"type": "integer", "minimum": 0},
    "skipped": {"type": "integer", "minimum": 0},
    "coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "test_name": {"type": "string"},
          "error_class": {"type": "string"},
          "error_message": {"type": "string"},
          "stack_tail": {"type": "string"},
          "likely_cause": {"type": "string"},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]}
        }
      }
    },
    "regressions": {"type": "integer", "minimum": 0},
    "evidence_paths": {"type": "array", "items": {"type": "string"}}
  }
}
