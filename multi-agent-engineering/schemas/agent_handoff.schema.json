{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etl4.iisc/schemas/agent_handoff.schema.json",
  "title": "Agent Handoff",
  "description": "Structured message emitted by any specialist agent at the end of its turn so the orchestrator can advance state and route the next task.",
  "type": "object",
  "required": ["project_id", "task_id", "from_agent", "to_agent", "current_phase", "status"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^PROJ-[0-9]{8}-[a-z0-9-]+$"},
    "task_id":    {"type": "string", "pattern": "^T-[0-9]{3,}$"},
    "from_agent": {"type": "string", "enum": ["orchestrator", "product-owner", "data-engineer", "developer-backend", "developer-frontend", "unit-tester", "functional-tester"]},
    "to_agent":   {"type": "string", "enum": ["orchestrator", "product-owner", "data-engineer", "developer-backend", "developer-frontend", "unit-tester", "functional-tester"]},
    "current_phase": {"type": "string", "enum": ["REQUIREMENTS", "ARCHITECTURE", "IMPLEMENTATION", "UNIT_TEST", "FUNCTIONAL_TEST", "CORE_SOLUTION_REVIEW", "DASHBOARD_SPEC", "DASHBOARD_IMPL", "DASHBOARD_ANALYSIS", "FINAL_ACCEPTANCE", "DONE"]},
    "objective":  {"type": "string"},
    "input_artifacts":  {"type": "array", "items": {"type": "string"}},
    "expected_output":  {"type": "string"},
    "dependencies":     {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["PENDING", "READY", "RUNNING", "BLOCKED", "UNDER_REVIEW", "APPROVED", "NEEDS_CHANGES", "REJECTED", "FAILED", "CONDITIONAL"]},
    "evidence": {
      "type": "object",
      "properties": {
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "commands_run": {"type": "array", "items": {"type": "string"}},
        "test_counts": {"type": "object"},
        "notes": {"type": "string"}
      }
    },
    "next_action": {"type": "string"},
    "timestamp_utc": {"type": "string", "format": "date-time"}
  }
}
