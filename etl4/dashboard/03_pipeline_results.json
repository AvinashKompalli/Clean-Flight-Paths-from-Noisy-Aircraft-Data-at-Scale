  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Wall-clock seconds by (method, noise) - latest run per combo",
      "type": "bargauge",
      "datasource": {
        "type": "postgres",
        "uid": "Postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 60},
              {"color": "red", "value": 300}
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Postgres"
          },
          "format": "table",
          "rawSql": "SELECT method || ' | ' || noise AS label, wall_secs AS wall_s FROM ( SELECT method, noise, wall_secs, ROW_NUMBER() OVER (PARTITION BY method, noise ORDER BY started_at DESC) AS rn FROM pipeline_runs WHERE wall_secs IS NOT NULL ) t WHERE rn = 1 ORDER BY noise, method;",
          "rawQuery": true
        }
      ]
    },
    {
