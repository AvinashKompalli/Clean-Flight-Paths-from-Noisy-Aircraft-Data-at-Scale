      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Postgres"
          },
          "format": "table",
          "rawSql": "SELECT r.method || ' | ' || r.noise AS label, e.value AS position_rmse_m FROM eval_results e JOIN pipeline_runs r ON r.run_id = e.run_id WHERE e.metric = 'position_rmse_m' AND (r.run_id, e.metric) IN ( SELECT r2.run_id, e2.metric FROM eval_results e2 JOIN pipeline_runs r2 ON r2.run_id = e2.run_id WHERE e2.metric = 'position_rmse_m' AND (r2.method, r2.noise, e2.recorded_at) IN ( SELECT r3.method, r3.noise, MAX(e3.recorded_at) FROM eval_results e3 JOIN pipeline_runs r3 ON r3.run_id = e3.run_id WHERE e3.metric = 'position_rmse_m' GROUP BY r3.method, r3.noise ) ) ORDER BY r.noise, r.method;",
          "rawQuery": true
        }
      ]
    },
