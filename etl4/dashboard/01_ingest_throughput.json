              },
              {
                "color": "green",
                "value": 25
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(records_sent_total[1m]))",
          "legendFormat": "records/s",
          "range": true,
          "instant": false
        }
      ]
    }
