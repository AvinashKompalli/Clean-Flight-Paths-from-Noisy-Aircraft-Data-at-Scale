# synthetic = fake data, no access needed. trino = real OpenSky data.
SOURCE=synthetic
KAFKA_BOOTSTRAP=localhost:9092
POSTGRES_USER=etl4
POSTGRES_PASSWORD=change_me
POSTGRES_DB=etl4
GRAFANA_PASSWORD=change_me
# OpenSky OAuth2 client credentials — get from opensky-network.org/my-account
